{
  "name": "asesoria-extension",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "generate": "node ../scripts/build-forms.mjs --target extension",
    "build": "npm run generate && tsc --noEmit && node build.mjs",
    "watch": "npm run generate && node build.mjs --watch",
    "check": "npm run generate && tsc --noEmit",
    "test": "npm run generate && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.14",
    "typescript": "~5.9.3"
  }
}
